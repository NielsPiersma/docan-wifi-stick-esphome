{#- Docan/Deye check during a full discharge and the charge afterwards.
    Paste into Home Assistant > Developer tools > Template and copy the whole
    output. Labels are in Dutch.

    The PACKS part only needs the shared ESPHome package (entity IDs
    sensor.docan_pack_<n>_...; change 'docan_pack_' in the macros ps and pb
    if your entities are named differently).
    The DEYE part uses the entity names of a Deye inverter integration.
    The ONTLADEN and NETSESSIE parts and the checks refer to the author's own
    Home Assistant helpers, scripts and automations (deye_full_discharge_*,
    deye_load_from_grid_*, ...), which are not part of this repository.
    Missing entities show as "–" or "niet gevonden". -#}
{%- macro v(e, d='–') -%}{{ states(e) if has_value(e) else d }}{%- endmacro -%}
{%- macro ps(p, k) -%}
  {%- set e = 'sensor.docan_pack_' ~ p ~ '_' ~ k -%}
  {%- if not has_value(e) -%}–{%- elif is_number(states(e)) -%}
    {%- set x = states(e) | float -%}{{ x | int if x == x | int else x | round(3) }}
  {%- else -%}{{ states(e) }}{%- endif -%}
{%- endmacro -%}
{%- macro pb(p, k) -%}
  {%- set e = 'binary_sensor.docan_pack_' ~ p ~ '_' ~ k -%}
  {%- if has_value(e) -%}{{ states(e) }}{%- else -%}–{%- endif -%}
{%- endmacro -%}
{%- macro hx(x) -%}{%- if is_number(x) -%}0x{{ '%04X' % (x | int) }}{%- else -%}–{%- endif -%}{%- endmacro -%}
{%- macro auto(id) -%}
  {%- set ns = namespace(t='niet gevonden') -%}
  {%- for a in states.automation if a.attributes.get('id') == id -%}
    {%- set lt = a.attributes.get('last_triggered') -%}
    {%- set ns.t = a.state ~ ', laatst ' ~ (as_local(lt).strftime('%d-%m %H:%M:%S') if lt else '-') ~ ', lopend ' ~ a.attributes.get('current', 0) -%}
  {%- endfor -%}{{ ns.t }}
{%- endmacro -%}
