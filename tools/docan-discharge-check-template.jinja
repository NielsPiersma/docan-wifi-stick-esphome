PACKS
{%- set lim = states('input_number.deye_full_discharge_min_cell_voltage') | float(3.0) %}
{%- set ns = namespace(minv=9, minp=0, warn=[]) %}
{%- for p in range(1, 5) %}
{%- set lo = ps(p, 'lowest_cell_voltage') | float(9) %}
{%- if lo < ns.minv %}{% set ns.minv = lo %}{% set ns.minp = p %}{% endif %}
{%- set rv = ps(p, 'raw_voltage_status') | int(0) %}
{%- set ra = ps(p, 'raw_alarm_status') | int(0) %}

Pack {{ p }}: comm {{ pb(p, 'bms_communication') }} | SOC {{ ps(p, 'state_of_charge') }}% | {{ ps(p, 'pack_voltage') }} V | {{ ps(p, 'pack_current') }} A
  cel min {{ ps(p, 'lowest_cell_voltage') }} V (#{{ ps(p, 'lowest_cell_number') }}) max {{ ps(p, 'highest_cell_voltage') }} V (#{{ ps(p, 'highest_cell_number') }}) delta {{ ps(p, 'cell_voltage_delta') }} mV
  MOS {{ ps(p, 'mos_temperature') }} °C | env {{ ps(p, 'environment_temperature') }} °C | balancer {{ pb(p, 'balancer_active') }} ({{ ps(p, 'balancing_cells') }})
  beveiliging {{ ps(p, 'bms_protections') }} | waarschuwing {{ ps(p, 'bms_warnings') }}
  raw V/I/T/A {{ hx(ps(p, 'raw_voltage_status')) }} {{ hx(ps(p, 'raw_current_status')) }} {{ hx(ps(p, 'raw_temperature_status')) }} {{ hx(ps(p, 'raw_alarm_status')) }} | FET {{ hx(ps(p, 'raw_fet_status')) }}
{#- 1194 = 0x04AA: cell/pack undervoltage protection and warning, undervoltage lock. -#}
{%- if rv | bitwise_and(1194) > 0 %}{% set ns.warn = ns.warn + ['pack ' ~ p ~ ': BMS meldt lage spanning'] %}{% endif %}
{#- 65151 = 0xFE7F: every alarm bit except SOC low (0x0080, 0x0100). -#}
{%- if ra | bitwise_and(65151) > 0 %}{% set ns.warn = ns.warn + ['pack ' ~ p ~ ': alarmbit buiten SOC-laag'] %}{% endif %}
{%- if not (pb(p, 'bms_communication') == 'on') %}{% set ns.warn = ns.warn + ['pack ' ~ p ~ ': geen communicatie'] %}{% endif %}
{%- endfor %}

CONTROLES
{%- set act = is_state('input_boolean.deye_full_discharge_active', 'on') %}
{%- set ok = namespace(l=[]) %}
{%- if act %}
{%- set ok.l = ok.l + [('Max charge 0 A', states('number.inverter_battery_max_charging_current') | int(-1) == 0)] %}
{%- set ok.l = ok.l + [('Low SOC = ondergrens', states('number.inverter_battery_low_soc') | int(-1) == fl | int)] %}
{%- set pc = namespace(ok=true) %}
{%- for n in range(1, 7) %}{% if states('number.inverter_program_' ~ n ~ '_soc') | int(-1) != fl | int %}{% set pc.ok = false %}{% endif %}{% endfor %}
{%- set ok.l = ok.l + [('Programma-SOC = ondergrens', pc.ok)] %}
{%- set ok.l = ok.l + [('Shutdown SOC < ondergrens', states('number.inverter_battery_shutdown_soc') | int(100) < fl | int)] %}
{%- if is_state('input_boolean.deye_full_discharge_export', 'on') %}
{%- set ok.l = ok.l + [('Work mode Export First', is_state('select.inverter_work_mode', 'Export First'))] %}
{%- endif %}
{%- set ok.l = ok.l + [('Accu ontlaadt', bp > 0)] %}
{%- else %}
{%- set ok.l = ok.l + [('Geen Export First buiten een ontlaadsessie', not is_state('select.inverter_work_mode', 'Export First'))] %}
{%- set ok.l = ok.l + [('Low SOC normaal (>= 20%)', states('number.inverter_battery_low_soc') | int(0) >= 20)] %}
{%- endif %}
{%- set ok.l = ok.l + [('Laagste cel ' ~ (ns.minv | round(3)) ~ ' V (pack ' ~ ns.minp ~ ') boven ' ~ lim ~ ' V', ns.minv > lim)] %}
{%- set ok.l = ok.l + [('Deye geen alarm of fout', is_state('binary_sensor.inverter_battery_alarm', 'off') and is_state('binary_sensor.inverter_battery_fault', 'off'))] %}
{%- for name, good in ok.l %}
[{{ 'OK  ' if good else 'LET OP' }}] {{ name }}
{%- endfor %}
{%- for w in ns.warn %}
[LET OP] {{ w }}
{%- endfor %}
